schematic
    name = "Instant Overdrive Projector"
    description = """
        Uses units to supply the projector with phase fabric from the core.

        Usage: build and set UNIT you want to use (flare by default)
        Build and attach switch to activate/deactivate.
        """

projector1:
    @overdrive-projector at ( 0,  0)
    @micro-processor     at ( 0,  2) processor
        links
            projector1
            message1
        end
        mindcode = file "overdrive-projector.mnd"
    end
message1:
    @message             at ( 1,  2)
end
