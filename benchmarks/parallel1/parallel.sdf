schematic
    name = "Parallelism Test"

    message1: @message
    cell1:    @memory-cell at (0, 1)

    Reg: region
        sorter1: @sorter at (1, 0)
        @micro-processor at (0, 0) processor
            links
                sorter1
                cell1
            end
            mindcode = file "parallel.mnd"
        end
    end at (1, 0) * (4, 4)

    // Recreate the first processor to also link to the message
    @micro-processor replace (1, 0) processor
        links
            Reg.sorter1     // Reg refers to the first instance of the region
            cell1
            message1
        end
        mindcode = file "parallel.mnd"
    end
end
