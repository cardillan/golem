schematic
    name = "Parallelism Test Large"

    bank1: @memory-bank
    message1: @message at (1,  2)

    Reg: region(1, 1)
        @micro-processor processor
            links
                display1
                bank1
            end
            mindcode = file "parallel-large.mnd"
        end
        display1: @tile-logic-display at (10, 0)
    end at (2, 0) * (8, 8)

    // Recreate the first processor to also link to the message
    @micro-processor replace (2, 0) processor
        links
            Reg.display1    // Reg refers to the first instance of the region
            message1
            bank1
        end
        mindcode = file "parallel-large.mnd"
    end
end
