set TRIANGLE_SIZE 10
print "1\n1 1\n"
set :lineLength 2
write 1 cell1 0
write 1 cell1 1
set :i 3
jump 33 greaterThan 3 TRIANGLE_SIZE
write 1 cell2 0
set :j 1
jump 17 greaterThan 1 :lineLength
op sub *tmp0 :j 1
read *tmp2 cell1 *tmp0
read *tmp3 cell1 :j
op add *tmp1 *tmp2 *tmp3
write *tmp1 cell2 :j
op add :j :j 1
jump 10 lessThanEq :j :lineLength
write 1 cell2 :lineLength
op add :lineLength :lineLength 1
set :c 0
jump 30 greaterThanEq 0 :lineLength
read *tmp4 cell2 :c
print *tmp4
read *tmp5 cell2 :c
write *tmp5 cell1 :c
op sub *tmp6 :lineLength 1
jump 28 greaterThanEq :c *tmp6
print " "
op add :c :c 1
jump 21 lessThan :c :lineLength
print "\n"
op add :i :i 1
jump 7 lessThanEq :i TRIANGLE_SIZE
printflush message1

