schematic
    name = "Parallelism Test Atomic"

                @micro-processor    at ( 0, 0) * (8, 8) processor links +(10, 0) as display * end mindcode = file "atomic.mnd" end
    memory:     @memory-bank        at (-2, 0)
    message:    @message            at (-1, 2)
    switch:     @switch             at (-2, 2) disabled
                @tile-logic-display at (10, 0) * (8, 8)
end
