set .slot 0
jump 1 equal display1 null
jump 2 equal bank1 null
jump 3 equal switch1 null
sensor *tmp0 bank1 @x
op sub *tmp1 @thisx *tmp0
op sub *tmp2 *tmp1 1.5
op round .px *tmp2 0
sensor *tmp3 bank1 @y
op sub *tmp4 @thisy *tmp3
op add *tmp5 *tmp4 0.5
op round .py *tmp5 0
op mul *tmp6 .px 30
op add .x 17 *tmp6
op mul *tmp7 .py 30
op add .y 17 *tmp7
draw reset 0 0 0 0 0 0
drawflush display1
sensor *tmp8 switch1 @enabled
jump 27 equal *tmp8 false
jump 29 notEqual .slot 0
wait 0.03334                            # 2.000 ticks for atomic execution of 4 steps at 2 ipt
read *tmp9 bank1 511
op add *tmp10 *tmp9 1
write *tmp10 bank1 511                  # The last atomic section instruction
set .slot *tmp10
jump 29 always 0 0
set .slot 0
write 0 bank1 511
print .slot
draw color 0 0 80 255 0 0
op sub *tmp11 .x 15
op sub *tmp12 .y 15
draw rect *tmp11 *tmp12 30 30 0 0
draw color 0 255 0 255 0 0
draw print .x .y @center 0 0 0
drawflush display1
print "Found {0} active processors."
read *tmp13 bank1 511
format *tmp13
printflush message1
jump 18 always 0 0
print "Compiled by Mindcode 3.17.0 - github.com/cardillan/mindcode"

