#set target = 8m;
#set syntax = strict;

const PROCESSORS = 16;

var slot = 0;

guarded linked(@tile-logic-display) display;
guarded linked(@memory-bank) memory;
guarded linked(@switch) switch;
noinit linked(@message) message;

var px = round(@thisx - memory.@x - 1.5);
var py = round(@thisy - memory.@y + 0.5);
var x = 17 + px * 30;
var y = 17 + py * 30;

external(memory[511]) counter;

begin
    reset();
    drawflush(display);

    loop
        if switch.enabled then
            if slot == 0 then
                slot = atomic(++counter);
            end;
        else
            slot = 0;
            counter = 0;
        end;

        print(slot);
        color(0, 0, 80, 255);
        rect(x - 15, y - 15, 30, 30);
        color(0, 255, 0, 255);
        drawPrint(x, y, @center);
        drawflush(display);

        print($"Found $counter active processors.");
        printflush(message);
    end;
end;
