# Mlog code compiled with support for symbolic labels
# You can safely add/remove instructions, in most parts of the program
# Pay closer attention to sections of the program manipulating @counter
label_0:
    read *tmp0 processor1 "*signature"
    jump label_0 notEqual *tmp0 "8bd373c6df37009f:v1"
label_2:
    read *tmp1 processor2 "*signature"
    jump label_2 notEqual *tmp1 "8bd37276df37009f:v1"
label_4:
    read *tmp2 processor3 "*signature"
    jump label_4 notEqual *tmp2 "8bd370a6df37009f:v1"
        control enabled switch1 false 0 0 0
    label_7:
            sensor *tmp3 switch1 @enabled
            jump label_7 equal *tmp3 false
                control enabled switch1 false 0 0 0
                write false processor1 ":clearArea0*finished"
                write 1 processor1 "@counter"
                write false processor2 ":clearArea1*finished"
                write 1 processor2 "@counter"
                write false processor3 ":clearArea2*finished"
                write 1 processor3 "@counter"
            label_16:
                wait 0
                read *tmp4 processor1 ":clearArea0*finished"
                jump label_16 equal *tmp4 false
            label_19:
                wait 0
                read *tmp5 processor2 ":clearArea1*finished"
                jump label_19 equal *tmp5 false
            label_22:
                wait 0
                read *tmp6 processor3 ":clearArea2*finished"
                jump label_22 equal *tmp6 false
            jump label_7 always 0 0
            print "Compiled by Mindcode 3.17.0 - github.com/cardillan/mindcode"

