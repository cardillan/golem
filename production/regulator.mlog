noop
jump 40 always 0 0                      # Origin: 12, keys: 0 .. 47, 50 .. 62, 65 .. 67, 71, 74 .. 89, 96 .. 136, 139 .. 145
set .message :initialize:block          # Origin: 12, keys: 137
jump 40 always 0 0
set .switch :initialize:block           # Origin: 12, keys: 138
jump 40 always 0 0
set .sorter :initialize:block           # Origin: 12, keys: 48, 49, 95
jump 40 always 0 0
set .container :initialize:block        # Origin: 12, keys: 63, 64, 146
set .measure @totalLiquids
set .maximum @liquidCapacity
op add .first :initialize:n 1
jump 40 always 0 0
set .container :initialize:block        # Origin: 12, keys: 72, 73
set .measure @totalPower
set .maximum @powerCapacity
op add .first :initialize:n 1
jump 40 always 0 0
set .container :initialize:block        # Origin: 12, keys: 68 .. 70
set .measure @powerNetStored
set .maximum @powerNetCapacity
op add .first :initialize:n 1
jump 40 always 0 0
set .container :initialize:block        # Origin: 12, keys: 90 .. 94
set .measure @totalItems
set .maximum @itemCapacity
op add .first :initialize:n 1
op sub :initialize:n :initialize:n 1
jump 7 greaterThanEq :initialize:n 0
print "Message: {0}\nSwitch: {0}\nSorter: {0}\nContainer: {0}\nFirst index: {0}\n"
format .message
format .switch
format .sorter
format .container
format .first
jump 51 notEqual .message null
print "No message.\n"
set :initialize:repeat true
jump 54 notEqual .switch null
print "No switch.\n"
set :initialize:repeat true
jump 57 notEqual .container null
print "No container.\n"
set :initialize:repeat true
printflush .message
jump 2 notEqual :initialize:repeat false
printflush null
set *tmp2 false
jump 65 lessThan PCT_LOW 0
jump 65 greaterThan PCT_LOW 100
op floor *tmp1 PCT_LOW 0
op strictEqual *tmp2 PCT_LOW *tmp1
jump 69 notEqual *tmp2 false
print "PCT_LOW must be an integer between 0 to 100."
printflush .message
stop
set *tmp4 false
jump 74 lessThan PCT_HIGH 0
jump 74 greaterThan PCT_HIGH 100
op floor *tmp3 PCT_HIGH 0
op strictEqual *tmp4 PCT_HIGH *tmp3
jump 78 notEqual *tmp4 false
print "PCT_HIGH must be an integer between 0 to 100."
printflush .message
stop
jump 82 lessThan PCT_LOW PCT_HIGH
print "PCT_LOW must be less than PCT_HIGH."
printflush .message
stop
sensor *tmp5 .sorter @type
op equal .inverted *tmp5 @inverted-sorter
set .state true
op add .cycles .cycles 1
op xor .active .inverted true
select .activeText notEqual .active false "\nCurrently active:[green]" "\nCurrently inactive:[salmon]"
control enabled .switch 0 0 0 0
