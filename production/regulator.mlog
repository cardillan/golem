sensor :amount .container .measure
jump 120 always 0 0
print "Measuring [gold]{0}[] in "
format :item
print .container
sensor :amount .container :item
op mul *tmp14 100 :amount
sensor *tmp15 .container .maximum
op idiv :pct *tmp14 *tmp15
jump 130 greaterThan :pct PCT_LOW
jump 136 equal .state true
set .state true
op add .cycles .cycles 1
op xor .active .inverted true
select .activeText notEqual .active false "\nCurrently active:[green]" "\nCurrently inactive:[salmon]"
jump 136 always 0 0
jump 136 lessThan :pct PCT_HIGH
jump 136 equal .state false
set .state false
