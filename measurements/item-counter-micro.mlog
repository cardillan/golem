set .conv*0 null
set .conv*1 null
set .conv*2 null
set .conv*3 null
set .memory null
set .found 0
set .links @links
op sub :initialize:n .links 1
jump 23 lessThan .links 1
getlink :initialize:block :initialize:n
sensor *tmp4 :initialize:block @type
jump 13 equal *tmp4 @memory-cell
jump 15 notEqual *tmp4 @memory-bank
set .memory :initialize:block
jump 21 always 0 0
jump 21 notEqual *tmp4 @plastanium-conveyor
set .conv*3 .conv*2
set .conv*2 .conv*1
set .conv*1 .conv*0
set .conv*0 :initialize:block
op add .found .found 1
op sub :initialize:n :initialize:n 1
jump 9 greaterThanEq :initialize:n 0
jump 28 notEqual .found 0
print "[gold]Item Counter Micro[], version [gold]1.0[]\n[salmon]No plastanium conveyor attached (maximum: 4, found: {0})"
format .found
printflush message1
jump 0 always 0 0
jump 33 lessThanEq .found 4
print "[gold]Item Counter Micro[], version [gold]1.0[]\n[salmon]Too many plastanium conveyors attached (maximum: 4, found: {0})"
format .found
printflush message1
jump 0 always 0 0
jump 37 notEqual .memory null
print "$TITLE\n[salmon]No memory attached."
printflush message1
jump 0 always 0 0
sensor *tmp13 .memory @type
select *tmp15 equal *tmp13 @memory-cell 63 511
set .totalIndex *tmp15
read .total .memory *tmp15
control enabled switch1 false 0 0 0
set :start @time
sensor *tmp25 .conv*0 @totalItems
set .state1*0 *tmp25
jump 47 greaterThanEq *tmp25 .state2*0
op add .total .total 10
sensor *tmp25 .conv*1 @totalItems
set .state1*1 *tmp25
jump 51 greaterThanEq *tmp25 .state2*1
op add .total .total 10
sensor *tmp25 .conv*2 @totalItems
set .state1*2 *tmp25
jump 55 greaterThanEq *tmp25 .state2*2
op add .total .total 10
sensor *tmp25 .conv*3 @totalItems
jump 58 greaterThanEq *tmp25 .state2*3
op add .total .total 10
write .total .memory .totalIndex
print "[gold]Item Counter Micro[], version [gold]1.0[]            \nMonitoring [green]{0}[] conveyors\nTotal items: [gold]{0}[]\n"
format .found
format .total
sensor *tmp40 .conv*0 @totalItems
set .state2*0 *tmp40
jump 66 greaterThanEq *tmp40 .state1*0
op add .total .total 10
sensor *tmp40 .conv*1 @totalItems
set .state2*1 *tmp40
jump 70 greaterThanEq *tmp40 .state1*1
op add .total .total 10
sensor *tmp40 .conv*2 @totalItems
set .state2*2 *tmp40
jump 74 greaterThanEq *tmp40 .state1*2
op add .total .total 10
sensor *tmp40 .conv*3 @totalItems
set .state2*3 *tmp40
jump 78 greaterThanEq *tmp40 *tmp25
op add .total .total 10
op sub *tmp48 @time :start
op idiv *tmp50 *tmp48 2
print "[lightgray]Loop time: {0} ms\n"
format *tmp50
printflush message1
jump 85 equal .links @links
end
sensor *tmp53 switch1 @enabled
jump 42 equal *tmp53 false
set .total 0
write 0 .memory .totalIndex
