set .DISPLAY null
set .MEMORY null
set .MESSAGE null
set .SWITCH null
print "Item/Liquid/Energy Level Display"
set :n @links
jump 23 lessThanEq :n 0
op sub :n :n 1
getlink :block :n
print "\nFound: "
print :block
sensor *tmp0 :block @type
sensor *tmp8 *tmp0 @id
read @counter "" *tmp8
jump 22 always 0 0                      # Origin: 13, keys: 0 .. 136, 139 .. 141, 144
set .DISPLAY :block                     # Origin: 13, keys: 145
jump 22 always 0 0
set .MESSAGE :block                     # Origin: 13, keys: 137
jump 22 always 0 0
set .SWITCH :block                      # Origin: 13, keys: 138
jump 22 always 0 0
set .MEMORY :block                      # Origin: 13, keys: 142, 143
jump 7 greaterThan :n 0
print "\nMessage: {0}\nSwitch: {0}\nMemory: {0}\nDisplay: "
format .MESSAGE
format .SWITCH
format .MEMORY
print .DISPLAY
op equal *tmp1 .MEMORY null
op equal *tmp2 .DISPLAY null
op or *tmp3 *tmp1 *tmp2
jump 33 equal *tmp3 false
print "\nNo memory or display."
printflush .MESSAGE
jump 4 notEqual *tmp3 false
read .CURRENT_INDEX .MEMORY 1
read .R0 .MEMORY 3
read .G0 .MEMORY 4
read .B0 .MEMORY 5
read .R1 .MEMORY 6
read .G1 .MEMORY 7
read .B1 .MEMORY 8
draw stroke 1 0 0 0 0 0
sensor *tmp4 .SWITCH @enabled
jump 81 notEqual *tmp4 0
set :start @time
print "Item/Liquid/Energy Level Display\nIndex: {0}\nValue: "
draw clear 0 0 80 0 0 0
draw color .R0 .G0 .B0 255 0 0
draw rect 10 10 156 156 0 0
read :head .MEMORY .CURRENT_INDEX
read :last .MEMORY :head
format :head
print :last
draw color .R1 .G1 .B1 255 0 0
set :x 159
op sub :head :head 1
read :value .MEMORY :head
op sub :x1 :x 5
draw line :x :last :x1 :value 0 0
set :x :x1
set :last :value
jump 56 greaterThan :x1 10
draw color 255 255 255 255 0 0
draw lineRect 10 10 156 156 0 0
op sub *tmp5 @time :start
print "\nTime: "
print *tmp5
op div *tmp6 @time 100
op ceil *tmp7 *tmp6 0
op mul :wait 100 *tmp7
set :loops 0
jump 75 greaterThanEq @time :wait
op add :loops :loops 1
jump 73 lessThan @time :wait
drawflush .DISPLAY
print "\nWait loops: "
print :loops
printflush .MESSAGE
sensor *tmp4 .SWITCH @enabled
jump 45 equal *tmp4 0
control enabled switch1 0 0 0 0

