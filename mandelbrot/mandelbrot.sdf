schematic
    name = "Mandelbrot Generator"
    description = """
        Draws the famous fractal on a large logic display using several hyperprocessors.
        Supports basic navigation (zoom in/out, camera movement), bookmarks, palette selection
        and showing a Julia set corresponding to the center of the displayed Mandelbrot fractal.

        Bookmarks: use buttons on the left of the top row to select a bookmark slot.
        Use buttons beneath the bookmark bar to load the bookmark/save current position to a bookmark.

        Palette: use buttons on the right of the top row.

        Julia set: an on/off switch below the message block showing current coordinates.

        Navigation: buttons below the display.
        """
    tag = "Cardillan"

    // Creates all conduits/routers at once
    // The region leaves empty space on the left and right for hyper-processors
    region(7, 3)
        @pulse-conduit       at ( 3,  0) facing north
        @pulse-conduit       at ( 3,  1) facing north
        @liquid-router       at ( 3,  2)
    end at (0, 1) * (2, 4)

    @liquid-source at ( 3,  0) liquid @cryofluid
    @liquid-source at (10,  0) liquid @cryofluid
    @liquid-source at (14,  5) liquid @cryofluid
    @liquid-source at (15,  3) liquid @cryofluid
    @liquid-source at (17,  5) liquid @cryofluid
    @liquid-source at (19,  3) liquid @cryofluid

    display:    @large-logic-display at (14,  9)
    memory:     @memory-bank         at (15,  4)
    message1:   @message             at (10, 14) text "Mandelbrot Mania! v3.1"
    message2:   @message             at ( 0, 15) text "Bookmarks"
    message3:   @message             at (14, 15) text "Palette selection"

    // Movement switches (using symbolic link names)
    buttonUp:    @switch  at (17,  4)
    buttonLeft:  @switch  at (16,  3)
    buttonRight: @switch  at (18,  3)
    buttonDown:  @switch  at (17,  3)
    buttonPlus:  @switch  at (14,  4)
    buttonMinus: @switch  at (14,  3)
    buttonJulia: @switch  at (10, 13)
    buttonLoad:  @switch  at ( 3, 14)
    buttonSave:  @switch  at ( 3, 13)

    // Bookmark switches (using symbolic link names)
    bookmark#: @switch at (1, 15) * (13, 1)

    // Palette switches (using symbolic link names)
    palette#: @switch at (15, 15) * (5, 1)

    // Hyper-processors as three discontinuous regions due to the cryofluid plumbing
    processor#: @hyper-processor fill  (0, 0) * (1, 5) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor fill  (4, 0) * (2, 5) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor fill (11, 0) * (3, 5) processor mindcode = file "mandelbrot-compute.mnd" end

    // The controller. It links to everything.
    @logic-processor at (18, 4) processor links * end mindcode = file "mandelbrot-control.mnd" end
end
