schematic
    name = "Mandelbrot Generator"
    tag = "Cardillan"

    @liquid-source       at ( 3,  0) liquid @cryofluid
    @pulse-conduit       at ( 3,  1) facing north
    @pulse-conduit       at ( 3,  2) facing north
    @liquid-router       at ( 3,  3)
    @pulse-conduit       at ( 3,  4) facing north
    @pulse-conduit       at ( 3,  5) facing north
    @liquid-router       at ( 3,  6)
    @pulse-conduit       at ( 3,  7) facing north
    @pulse-conduit       at ( 3,  8) facing north
    @liquid-router       at ( 3,  9)
    @pulse-conduit       at ( 3, 10) facing north
    @pulse-conduit       at ( 3, 11) facing north
    @liquid-router       at ( 3, 12)

    @liquid-source       at (10,  0) liquid @cryofluid
    @pulse-conduit       at (10,  1) facing north
    @pulse-conduit       at (10,  2) facing north
    @liquid-router       at (10,  3)
    @pulse-conduit       at (10,  4) facing north
    @pulse-conduit       at (10,  5) facing north
    @liquid-router       at (10,  6)
    @pulse-conduit       at (10,  7) facing north
    @pulse-conduit       at (10,  8) facing north
    @liquid-router       at (10,  9)
    @pulse-conduit       at (10, 10) facing north
    @pulse-conduit       at (10, 11) facing north
    @liquid-router       at (10, 12)

    @liquid-source       at (14,  5) liquid @cryofluid
    @liquid-source       at (15,  3) liquid @cryofluid
    @liquid-source       at (17,  5) liquid @cryofluid
    @liquid-source       at (19,  3) liquid @cryofluid

    processor#: @hyper-processor    at ( 0, 0) .. ( 0, 12) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor    at ( 4, 0) .. ( 4, 12) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor    at ( 7, 0) .. ( 7, 12) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor    at (11, 0) .. (11, 12) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor    at (14,  0) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor    at (14,  6) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor    at (17,  0) processor mindcode = file "mandelbrot-compute.mnd" end
    processor#: @hyper-processor    at (17,  6) processor mindcode = file "mandelbrot-compute.mnd" end

display:
    @large-logic-display at (14,  9)

memory:
    @memory-bank         at (15,  4)

message1:
    @message             at (10, 14) text "Mandelbrot Mania! v3.1"

message2:
    @message             at ( 0, 15) text "Bookmarks"

message3:
    @message             at (14, 15) text "Palette selection"

    // Movement switches
    buttonUp:    @switch  at (17,  4)
    buttonLeft:  @switch  at (16,  3)
    buttonRight: @switch  at (18,  3)
    buttonDown:  @switch  at (17,  3)
    buttonPlus:  @switch  at (14,  4)
    buttonMinus: @switch  at (14,  3)
    buttonJulia: @switch  at (10, 13)
    buttonLoad:  @switch  at ( 3, 14)
    buttonSave:  @switch  at ( 3, 13)

    // Bookmark switches
    bookmark#: @switch  at ( 1, 15) * (13, 1)

    // Palette switches
    palette#: @switch  at (15, 15) * (5, 1)

    @logic-processor     at (18,  4) processor links * end mindcode = file "mandelbrot-control.mnd" end
end
