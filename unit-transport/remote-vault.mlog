set LINK_ID 1
jump 1 equal vault1 null
jump 2 equal message1 null
op add .queryFlag 99999900 LINK_ID
sensor *tmp0 vault1 @x
sensor *tmp1 vault1 @y
op mul *tmp2 @mapw *tmp1
op add *tmp3 *tmp0 *tmp2
op mul .position 100 *tmp3
op add .answerFlag .position LINK_ID
set .serviced 0
set :start @time
ubind @mono
sensor *tmp4 @unit @flag
jump 17 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @poly
sensor *tmp4 @unit @flag
jump 22 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @mega
sensor *tmp4 @unit @flag
jump 27 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @quad
sensor *tmp4 @unit @flag
jump 32 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @oct
sensor *tmp4 @unit @flag
jump 37 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @flare
sensor *tmp4 @unit @flag
jump 42 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @horizon
sensor *tmp4 @unit @flag
jump 47 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @zenith
sensor *tmp4 @unit @flag
jump 52 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @antumbra
sensor *tmp4 @unit @flag
jump 57 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
ubind @eclipse
sensor *tmp4 @unit @flag
jump 62 notEqual *tmp4 .queryFlag
ucontrol flag .answerFlag 0 0 0 0
op add .serviced .serviced 1
print "Remote vault [gold]#{0}[]\nQueries serviced: [green]{0}[]\n[lightgray]Loop time: {0} ms\n"
format LINK_ID
format .serviced
op sub *tmp5 @time :start
op floor *tmp6 *tmp5 0
format *tmp6
printflush message1
jump 11 always 0 0
print "Compiled by Mindcode 3.17.0 - github.com/cardillan/mindcode"

