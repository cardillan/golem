op max *tmp21 *tmp20 -9
op add :measure 9 *tmp21
op shl *tmp23 :accumulator 5
op or :accumulator *tmp23 :measure
sensor :actual :localCore @coal
op sub *tmp18 :actual 100
op idiv :measure *tmp18 10
op min *tmp20 :measure 9
op max *tmp21 *tmp20 -9
op add :measure 9 *tmp21
op shl *tmp23 :accumulator 5
op or :accumulator *tmp23 :measure
read *tmp28 processor1 ".sandContainer"
sensor :actual *tmp28 @sand
op sub *tmp18 :actual 100
op idiv :measure *tmp18 10
op min *tmp20 :measure 9
op max *tmp21 *tmp20 -9
op add :measure 9 *tmp21
op shl *tmp23 :accumulator 5
op or :accumulator *tmp23 :measure
set *tmp11 100
read *tmp11 processor1 "lead"
sensor :actual :localCore @lead
op sub *tmp18 :actual *tmp11
op idiv :measure *tmp18 10
op min *tmp20 :measure 9
op max *tmp21 *tmp20 -9
op add :measure 9 *tmp21
op shl *tmp23 :accumulator 5
op or :accumulator *tmp23 :measure
set *tmp11 100
read *tmp11 processor1 "copper"
sensor :actual :localCore @copper
op sub *tmp18 :actual *tmp11
op idiv :measure *tmp18 10
op min *tmp20 :measure 9
op max *tmp21 *tmp20 -9
op add :measure 9 *tmp21
op shl *tmp23 :accumulator 5
op or :accumulator *tmp23 :measure
op add :newTail .tail 1
write :accumulator bank1 :newTail
set .tail :newTail
write :newTail bank1 510
jump 5 always 0 0
