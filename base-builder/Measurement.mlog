set *id "id: Measurements\nname: Base Builder\nversion: v0.4.0"
write 0 bank1 511
set .tail -1
write -1 bank1 510
set .nextTime 1800
read *tmp4 processor2 "time"
jump 5 lessThan *tmp4 .nextTime
op add .nextTime .nextTime 1800
read :localCore processor1 ".core"
jump 5 equal :localCore null
set *tmp11 100
read *tmp11 processor1 "thorium"
sensor :actual :localCore @thorium
op sub *tmp18 :actual *tmp11
op idiv :measure *tmp18 10
op min *tmp20 :measure 9
op max *tmp21 *tmp20 -9
op add :measure 9 *tmp21
set :accumulator :measure
set *tmp11 100
read *tmp11 processor1 "metaglass"
sensor :actual :localCore @metaglass
op sub *tmp18 :actual *tmp11
op idiv :measure *tmp18 10
op min *tmp20 :measure 9
op max *tmp21 *tmp20 -9
op add :measure 9 *tmp21
op shl *tmp23 :accumulator 5
op or :accumulator *tmp23 :measure
set *tmp11 100
read *tmp11 processor1 "titanium"
