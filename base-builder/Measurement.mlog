set *id "id: Measurements"
write 0 bank1 511
set .tail -1
write -1 bank1 510
set .nextTime 1800
read *tmp0 processor2 "time"
jump 5 lessThan *tmp0 .nextTime
op add .nextTime .nextTime 1800
read :localCore processor1 ".core"
jump 5 equal :localCore null
set *tmp1 100
read *tmp1 processor1 "thorium"
sensor :actual :localCore @thorium
op sub *tmp2 :actual *tmp1
op idiv :measure *tmp2 10
op min *tmp3 :measure 9
op max *tmp4 *tmp3 -9
op add :measure 9 *tmp4
set :accumulator :measure
set *tmp1 100
read *tmp1 processor1 "metaglass"
