set *id "id: Mono Controller"
set .min 0
set .minOre null
set copper @ore-copper
set scrap @ore-scrap
set lead @ore-lead
set sand @sand-floor
set *signature "0:v1"
ubind @mono
set :backgroundProcess:firstUnit @unit
ulocate building core false @copper .coreX .coreY 0 .core
jump 8 equal .core null
set :backgroundProcess:runningCount 0
ubind @mono
sensor *tmp0 :backgroundProcess:firstUnit @dead
select :backgroundProcess:firstUnit notEqual *tmp0 false @unit :backgroundProcess:firstUnit
jump 41 notEqual @unit :backgroundProcess:firstUnit
printflush message1
sensor *tmp1 .core @lead
op sub :backgroundProcess:lead *tmp1 .leadTarget
sensor *tmp2 .sandContainer @sand
sensor *tmp3 .sandContainer @scrap
op add *tmp4 *tmp2 *tmp3
op sub :backgroundProcess:sand *tmp4 .sandTarget
sensor *tmp5 .core @copper
op sub :backgroundProcess:copper *tmp5 .copperTarget
op min *tmp6 :backgroundProcess:lead :backgroundProcess:sand
op min *tmp6 *tmp6 :backgroundProcess:copper
select *tmp8 equal *tmp6 :backgroundProcess:lead @lead @copper
select *tmp7 equal *tmp6 :backgroundProcess:sand @sand *tmp8
set .minOre *tmp7
jump 33 equal .scrap false
select .minOre equal *tmp7 @sand @scrap *tmp7
print "minOre:{0}\n"
format .minOre
op mul *tmp9 10 :backgroundProcess:runningCount
op add .min *tmp6 *tmp9
set .count :backgroundProcess:runningCount
set :backgroundProcess:runningCount 2
sensor .sandX .sandContainer @x
sensor .sandY .sandContainer @y
op add :backgroundProcess:runningCount :backgroundProcess:runningCount 1
sensor :backgroundProcess:flag @unit @flag
print "Unit flag: {0}\n"
format :backgroundProcess:flag
jump 65 notEqual :backgroundProcess:flag 0
sensor *tmp10 @unit @firstItem
jump 51 equal *tmp10 null
ucontrol itemDrop @air 20 0 0 0
sensor *tmp11 @unit @firstItem
jump 13 notEqual *tmp11 null
ulocate ore core true .minOre :findOreToMine:x :findOreToMine:y 0 0
ucontrol approach :findOreToMine:x :findOreToMine:y 7 0 0
ucontrol mine :findOreToMine:x :findOreToMine:y 0 0 0
op mul *tmp12 :findOreToMine:x 1000
op add *tmp13 *tmp12 :findOreToMine:y
op mul *tmp14 *tmp13 16
sensor *tmp15 .minOre @id
op add *tmp16 *tmp14 *tmp15
ucontrol flag *tmp16 0 0 0 0
print "Found {0} at {0}, {0}\n"
format .minOre
format :findOreToMine:x
format :findOreToMine:y
jump 13 always 0 0
jump 80 notEqual :backgroundProcess:flag 1
print "Returning ore"
sensor *tmp17 @unit @firstItem
jump 72 notEqual *tmp17 @scrap
ucontrol approach .sandX .sandY 7 0 0
ucontrol itemDrop .sandContainer 20 0 0 0
jump 74 always 0 0
ucontrol approach .coreX .coreY 7 0 0
ucontrol itemDrop .core 20 0 0 0
sensor *tmp18 @unit @firstItem
jump 78 notEqual *tmp18 null
print " (finished)\n"
ucontrol flag 0 0 0 0 0
print "\n"
jump 13 always 0 0
print "Mining "
op mod *tmp19 :backgroundProcess:flag 16
lookup item :mine:ore *tmp19
printchar :mine:ore
op idiv :mine:flag :backgroundProcess:flag 16
op mod :mine:y :mine:flag 1000
op idiv :mine:x :mine:flag 1000
sensor *tmp20 :mine:ore @name
read :mine:floorOre @this *tmp20
op sub *tmp24 20 .count
select *tmp21 equal :mine:ore @scrap *tmp24 20
jump 98 equal :mine:ore .minOre
jump 98 equal :mine:ore @scrap
sensor *tmp22 .core :mine:ore
jump 98 lessThanEq *tmp22 .min
print ", switching to a more needed ore"
ucontrol flag 1 0 0 0 0
jump 13 always 0 0
sensor :mine:items @unit @totalItems
print :mine:items
sensor *tmp23 @unit @firstItem
jump 104 equal *tmp23 :mine:ore
print " (dropping)"
ucontrol itemDrop @air 20 0 0 0
jump 114 lessThan :mine:items *tmp21
print ", full"
ucontrol flag 1 0 0 0 0
jump 111 notEqual :mine:ore @scrap
ucontrol approach .sandX .sandY 7 0 0
ucontrol itemDrop .sandContainer 20 0 0 0
jump 131 always 0 0
ucontrol approach .coreX .coreY 7 0 0
ucontrol itemDrop .core 20 0 0 0
jump 131 always 0 0
print " at {0}, "
format :mine:x
print :mine:y
ucontrol approach :mine:x :mine:y 7 0 0
ucontrol getBlock :mine:x :mine:y 0 :mine:block :mine:floor
jump 126 equal :mine:floor :mine:floorOre
jump 123 notEqual :mine:floor null
print ": too far\n"
jump 131 always 0 0
ucontrol flag 1 0 0 0 0
print ": no ore!\n"
jump 131 always 0 0
jump 129 notEqual :mine:block null
ucontrol mine :mine:x :mine:y 0 0 0
jump 131 always 0 0
ucontrol flag 1 0 0 0 0
print ": blocked!\n"
print "\n"
jump 13 always 0 0
print "Compiled by Mindcode 3.16.3 - github.com/cardillan/mindcode"
