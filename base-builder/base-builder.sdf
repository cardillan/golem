schematic
    target = 8
    name = "Base Builder"
    tag = "Cardillan"
    description = """
        The schematic builds and runs a base around the core until a mega is produced. Unless the resources are scarce or far away, the mega is produced within approximately 30 minutes.

        [gray]Prerequisites:

        * A single Shard core must be present on the map.

        * 13x13 area centered on the core must be empty (allow buildings to be built).

        * Copper, lead, coal, titanium and thorium ore, and a sand tile or a scrap ore, must be present on the map.

        * The titanium and thorium ore must allow a drill to be built on them, and the area around thorium must allow building required infrastructure.

        []The world processor in the schematic sets up a single poly near the core. The switch changes the information shown on the display.

        [gold]This schematic was originally created as an entry for Skye's Jam of July 2025.
        """

    mindcode = """
        #set syntax = strict;
        #set program-name = "Base Builder";
        #set program-version = "v0.4.0";
        """

nextPage:
    @switch              at ( 0,  0) disabled

message:
    @message             at ( 1,  0) text ""

timer:
    @micro-processor     at ( 2,  0) processor mlog = "op add time time 1" end

coreControllerConfig:
    // A template for building the processor controlling the core
    @micro-processor     at ( 3, 0) processor mindcode = file "CoreController.mnd" end

displayProcessor:
    @logic-processor     at ( 0,  1) processor
        links
            display
            message
            nextPage
            oreLocator
            oreLogMemory
            resourceHistory
            timer
        end
        mindcode = file "Display.mnd"
    end

measurements:
    @micro-processor     at ( 2,  1) processor
        links
            builderController
            resourceHistory
            timer
        end
        mindcode = file "Measurement.mnd"
    end

polyController:
    @micro-processor     at ( 3,  1) processor mindcode = file "PolyController.mnd" end

monoController:
    @micro-processor     at ( 2,  2) processor mindcode = file "MonoController.mnd" end

flareController:
    @micro-processor     at ( 3,  2) processor
        links
            displayProcessor
        end
        mindcode = file "FlareController.mnd"
    end

oreLocator:
    @logic-processor     at ( 0,  3) processor
        links
            matrices
            oreLogMemory
        end
        mindcode = file "OreLocator.mnd"
    end

matrices:
    @logic-processor     at ( 2,  3) processor mindcode = file "Matrices.mnd" end

baseBuilder:
    @logic-processor     at ( 0, 5) processor
        links
            builderController
            coreControllerConfig
            displayProcessor
            flareController
            measurements
            monoController
            oreLocator
            oreLogMemory
            polyController
            timer
        end
        mindcode = file "BaseBuilder.mnd"
    end

builderController:
    @logic-processor     at ( 2,  5) processor
        links
            oreLogMemory
            timer
            displayProcessor
            oreLocator
            polyController
            monoController
            flareController
            baseBuilder
        end
        mindcode = file "BuilderController.mnd"
    end

oreLogMemory:
    @memory-bank         at ( 0,  7)

resourceHistory:
    @memory-bank         at ( 2,  7)

display:
    @tile-logic-display  at (4, 0) * (6, 9)

    // Poly spawner
    @world-processor     at (-1,  8) processor mindcode = """
        #set processor-id = "Spawner";

        begin
            setrule(:waves, false);
            var core = fetch(:core, @sharded, 0);
            spawn(@poly, core.@x, core.@y, 90, @sharded, true);
            stopProcessor();
        end;
        """
    end
end
